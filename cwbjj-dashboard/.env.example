# Copy to .env.local for local development. On Vercel, add these under Settings > Environment Variables.

# Sign-in
DASHBOARD_PASSWORD=
AUTH_SECRET=

# Show sample numbers instead of calling PostHog and GoHighLevel
USE_MOCK_DATA=1

# PostHog (EU)
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=

# GoHighLevel (leave empty until the token is ready; the dashboard shows "Not connected yet")
GHL_TOKEN=
GHL_LOCATION_ID=

# Weekly email
RESEND_API_KEY=
REPORT_RECIPIENT=
REPORT_FROM=
CRON_SECRET=
DASHBOARD_URL=
